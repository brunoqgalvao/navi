{
  "name": "navi-app",
  "version": "2.0.8",
  "description": "Navi — the local AI coding assistant UI. Already on it.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"bun run server\" \"bun run pty\" \"bun run dev\"",
    "dev:nowatch": "bun run build && concurrently \"bun run server\" \"bun run pty\" \"bun run preview\"",
    "postinstall": "node scripts/repair-sharp.mjs",
    "repair:sharp": "node scripts/repair-sharp.mjs",
    "start": "node scripts/repair-sharp.mjs && node scripts/run-with-bun.mjs run bin/navi.ts",
    "server": "node scripts/repair-sharp.mjs && node scripts/run-with-bun.mjs run server/index.ts",
    "pty": "node server/pty-server.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test:api": "node scripts/run-with-bun.mjs run server/test-api.ts",
    "test:api:verbose": "node scripts/run-with-bun.mjs run server/test-api.ts --verbose"
  },
  "license": "MIT",
  "bin": {
    "navi": "./bin/navi.ts",
    "navi-integrations": "./server/integrations/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/google": "^3.0.10",
    "@ai-sdk/openai": "^3.0.12",
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@anthropic-ai/claude-code": "2.1.226",
    "@anthropic-ai/sdk": "^0.71.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@friendofsvelte/mermaid": "^0.0.4",
    "@google/gemini-cli": "0.41.2",
    "@openai/codex": "0.130.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/three": "^0.182.0",
    "@xyflow/svelte": "^1.5.0",
    "adm-zip": "^0.5.16",
    "ai": "^6.0.39",
    "archiver": "^7.0.1",
    "chart.js": "^4.5.1",
    "codemirror": "^6.0.2",
    "croner": "^9.1.0",
    "diff": "^8.0.2",
    "e2b": "^2.9.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-svelte": "^0.562.0",
    "marked": "^17.0.1",
    "node-pty": "^1.1.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.13.0",
    "svelte-json-tree": "^2.2.0",
    "three": "^0.182.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/bun": "^1.3.13",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-musl": "^4.55.1"
  },
  "trustedDependencies": [
    "@anthropic-ai/claude-code",
    "esbuild",
    "sharp"
  ]
}

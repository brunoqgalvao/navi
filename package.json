{
  "name": "claude-code-local-ui",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "bun run --cwd packages/navi-app dev:all",
    "dev:app": "bun run --cwd packages/navi-app dev:all",
    "dev:nowatch": "bun run --cwd packages/navi-app dev:nowatch",
    "dev:tauri": "bun run --cwd packages/navi-app tauri:dev",
    "dev:landing": "bun run --cwd packages/landing-page dev",
    "kill": "lsof -ti:1420,3021,3022 | xargs kill -9 || true",
    "build": "bun run --cwd packages/navi-app build && bun run --cwd packages/landing-page build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.0.76"
  }
}
